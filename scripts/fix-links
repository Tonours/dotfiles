#!/usr/bin/env bash
# fix-links — check/repair dotfiles managed symlinks (env + herdr skill).
# Standalone: no etabli dependency. Usage: scripts/fix-links [--fix] [--verbose]
set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
FIX=0
VERBOSE=0
ISSUES=0
TIMESTAMP="$(date +%Y%m%d-%H%M%S)"

while [ $# -gt 0 ]; do
  case "$1" in
    --fix) FIX=1 ;;
    --verbose) VERBOSE=1 ;;
    -h|--help) sed -n '2,3p' "$0"; exit 0 ;;
    *) printf 'unknown option: %s\n' "$1" >&2; exit 2 ;;
  esac
  shift
done

check_link() {
  local link="$1" target="$2" label="$3"
  local backup index
  if [ ! -e "$target" ]; then
    printf 'MISSING   %s source (%s)\n' "$label" "$target" >&2
    ISSUES=$((ISSUES + 1))
    return 0
  fi
  if [ -L "$link" ] && [ "$(readlink "$link")" = "$target" ]; then
    [ "$VERBOSE" -eq 1 ] && printf 'OK        %s\n' "$label"
    return 0
  fi
  ISSUES=$((ISSUES + 1))
  if [ "$FIX" -eq 1 ]; then
    mkdir -p "$(dirname "$link")"
    if [ -e "$link" ] && [ ! -L "$link" ]; then
      backup="$link.bak.$TIMESTAMP"
      index=1
      while [ -e "$backup" ] || [ -L "$backup" ]; do
        backup="$link.bak.$TIMESTAMP.$index"
        index=$((index + 1))
      done
      mv "$link" "$backup"
      printf 'BACKUP    %s -> %s\n' "$link" "$backup"
    else
      rm -f "$link"
    fi
    ln -s "$target" "$link"
    printf 'FIXED     %s -> %s\n' "$label" "$target"
  else
    printf 'DRIFT     %s (want %s)\n' "$label" "$target"
  fi
}

SKILL="$DOTFILES_DIR/herdr/skills/herdr"
check_link "$HOME/.config/nvim" "$DOTFILES_DIR/nvim" "nvim"
check_link "$HOME/.tmux.conf" "$DOTFILES_DIR/tmux.conf" "tmux config"
check_link "$HOME/.config/ghostty/config" "$DOTFILES_DIR/ghostty/config" "ghostty config"
check_link "$HOME/.config/herdr/config.toml" "$DOTFILES_DIR/herdr/config.toml" "herdr config"
check_link "$HOME/.config/herdr/plugins/config/sessionizer/config.toml" "$DOTFILES_DIR/herdr/layouts/sessionizer.config.toml" "herdr sessionizer layout"
check_link "$HOME/.local/bin/tmux-clipboard.sh" "$DOTFILES_DIR/scripts/tmux-clipboard.sh" "tmux clipboard script"
check_link "$HOME/.local/bin/herdr-sync-mini" "$DOTFILES_DIR/scripts/herdr-sync-mini" "herdr-sync-mini script"
check_link "$HOME/.claude/skills/herdr" "$SKILL" "herdr skill (claude)"
check_link "$HOME/.codex/skills/herdr" "$SKILL" "herdr skill (codex)"
check_link "$HOME/.config/devin/skills/herdr" "$SKILL" "herdr skill (devin)"
check_link "$HOME/.agents/skills/herdr" "$SKILL" "herdr skill (agents)"
check_link "$HOME/.pi/agent/skills/herdr" "$SKILL" "herdr skill (pi)"

printf 'Summary: %d issue(s)%s\n' "$ISSUES" "$([ "$FIX" -eq 1 ] && echo " (fixed)" || echo " (run --fix)")"
if [ "$FIX" -eq 1 ]; then
  exec "$0"
fi
[ "$ISSUES" -eq 0 ]
